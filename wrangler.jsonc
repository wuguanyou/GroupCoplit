{
  "name": "grouppilot",
  "main": "worker.ts",
  "triggers": { "crons": ["0 * * * *"] },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grouppilot",
      "database_id": "e0cff961-69f4-4dcf-8834-5ae18a0b775a",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "grouppilot-files"
    }
  ],
  "account_id": "3e5ac9197d1a0167db15fc153912a17f"
}
